[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/k14n/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main --profile agent-admin gateway run
WorkingDirectory=/home/k14n/.hermes/profiles/agent-admin
Environment="PATH=/home/k14n/.hermes/hermes-agent/venv/bin:/home/k14n/.hermes/hermes-agent/node_modules/.bin:/usr/bin:/home/k14n/.local/bin:/home/k14n/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/k14n/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=/home/k14n/.hermes/profiles/agent-admin"
Environment="HERMES_SUPERVISED_CHILD=1"
Restart=always
RestartSec=5
RestartForceExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStopPost=-/home/k14n/.hermes/hermes-agent/venv/bin/python -m gateway.cgroup_cleanup
TimeoutStopSec=70
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
