{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 5,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/logo",
        "group/hardware",
        "hyprland/workspaces",
        "custom/cava"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
    "group/status",
    "group/system",
    "custom/coffee",
    "custom/power"
    ],

    "custom/logo": {
        "format": "",
        "tooltip": false
    },

    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "battery",
            "cpu",
            "memory"
        ]
    },

    "battery": {
        "format": " {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "interval": 30,
        "tooltip": false
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "● {percentage}%",
        "interval": 2,
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "●",
            "default": "•"
        },
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5, 6]
        }
    },

    "custom/cava": {
        "exec": "/home/k14n/.config/waybar/scripts/cava.sh",
        "restart-interval": 1,
        "tooltip": false
    },

    "clock": {
        "format": "{:%H:%M}",
        "interval": 1,
        "tooltip": false
    },

    "group/status": {
        "orientation": "horizontal",
        "modules": [
            "wireplumber",
            "bluetooth",
            "hyprland/window",
            "network"
        ]
    },

    "wireplumber": {
        "format": " {volume}%",
        "format-muted": "󰝟",
        "tooltip": false,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": "",
        "tooltip": false
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 14,
        "separate-outputs": true
    },

    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip": false
    },

    "group/system": {
        "orientation": "horizontal",
        "modules": [
            "custom/storage",
            "custom/temp"
        ]
    },

    "custom/storage": {
        "format": "󰋊 {}",
        "exec": "df -h / | awk 'NR==2 {print $3\"/\"$2}'",
        "interval": 30,
        "tooltip": false
    },

    "custom/temp": {
        "format": " {}°",
        "exec": "sensors 2>/dev/null | awk '/Package id 0:/ {gsub(/[+°C]/,\"\",$4); print int($4); exit}'",
        "interval": 5,
        "tooltip": false
    },

    "custom/coffee": {
    "exec": "/home/k14n/.config/waybar/scripts/coffee-mode.sh",
    "return-type": "json",
    "interval": 2,
    "on-click": "/home/k14n/.config/waybar/scripts/coffee-mode.sh toggle",
    "tooltip": true
    },

    "custom/power": {
        "format": "",
        "on-click": "shutdown -h now",
        "tooltip": false
    }
}
